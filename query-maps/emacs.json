{
  "$emacs": { "featureSections": true, "omitPredicates": true },
  "highlights": {
    "_definition": { "capture": "font-lock-variable-name-face", "feature": "definition-names" },
    "attribute": "",
    "comment": "",
    "comment.block": "",
    "comment.block.documentation": { "capture": "font-lock-doc-face", "feature": "doc-comments" },
    "comment.line": { "capture": "font-lock-comment-face", "feature": "comments" },
    "constant": "",
    "constant.builtin": "",
    "constant.builtin.boolean": { "capture": "font-lock-constant-face", "feature": "tags" },
    "constant.character": { "capture": "font-lock-string-face", "feature": "strings" },
    "constant.character.escape": { "capture": "font-lock-escape-face", "feature": "string-escapes" },
    "constant.numeric": { "capture": "font-lock-number-face", "feature": "numbers" },
    "constant.numeric.float": { "capture": "font-lock-number-face", "feature": "numbers" },
    "constant.numeric.integer": { "capture": "font-lock-number-face", "feature": "numbers" },
    "constructor": { "capture": "font-lock-builtin-face", "feature": "tags" },
    "function": { "capture": "font-lock-function-name-face", "feature": "definition-names" },
    "function.roc-special.call": { "capture": "font-lock-function-call-face", "feature": "function-calls" },
    "function.roc-special.derive": { "capture": "font-lock-function-name-face", "feature": "definition-names" },
    "function.builtin": { "capture": "font-lock-keyword-face", "feature": "keywords" },
    "function.method": { "capture": "font-lock-function-call-face", "feature": "function-calls" },
    "ignoreme.module": "",
    "keyword": "",
    "keyword.control": { "capture": "font-lock-keyword-face", "feature": "keywords" },
    "keyword.control.conditional": { "capture": "font-lock-keyword-face", "feature": "keywords" },
    "keyword.control.exception": { "capture": "roc-ts-crash-face", "feature": "keywords" },
    "keyword.control.import": { "capture": "font-lock-keyword-face", "feature": "keywords" },
    "keyword.control.repeat": { "capture": "font-lock-keyword-face", "feature": "keywords" },
    "keyword.control.return": { "capture": "font-lock-keyword-face", "feature": "keywords" },
    "keyword.control.return.roc-special.try": { "capture": "roc-ts-question-mark-face", "feature": "early-return" },
    "keyword.directive": "",
    "keyword.function": "",
    "keyword.operator": "",
    "keyword.storage.modifier": "",
    "keyword.storage.type": "",
    "label": "",
    "module": "",
    "namespace": { "capture": "font-lock-constant-face", "feature": "modules" },
    "namespace.roc-special.builtin": { "capture": "font-lock-constant-face", "feature": "modules" },
    "operator": { "capture": "font-lock-operator-face", "feature": "operators" },
    "operator.roc-special.arrow": { "capture": "font-lock-operator-face", "feature": "operators" },
    "operator.roc-special.fat-arrow": { "capture": "font-lock-misc-punctuation-face", "feature": "arrows" },
    "operator.roc-special.in-typedef": { "capture": "font-lock-operator-face", "feature": "operators" },
    "operator.roc-special.assignment": { "capture": "font-lock-misc-punctuation-face", "feature": "assignments" },
    "punctuation": "",
    "punctuation.bracket": { "capture": "font-lock-bracket-face", "feature": "brackets" },
    "punctuation.bracket.roc-special.lambda": { "capture": "font-lock-misc-punctuation-face", "feature": "lambdas" },
    "punctuation.bracket.roc-special.in-typedef": { "capture": "font-lock-bracket-face", "feature": "brackets" },
    "punctuation.delimiter": { "capture": "font-lock-misc-punctuation-face", "feature": "arrows" },
    "punctuation.delimiter.roc-special.ordinary": { "capture": "font-lock-delimiter-face", "feature": "delimiters" },
    "punctuation.delimiter.roc-special.in-typedef": { "capture": "font-lock-delimiter-face", "feature": "delimiters" },
    "punctuation.special": { "capture": "font-lock-escape-face", "feature": "string-escapes" },
    "roc-special.error": { "capture": "default", "feature": "errors" },
    "special": "",
    "special.roc-special.exposed": { "capture": "font-lock-variable-use-face", "feature": "variable-use" },
    "special.roc-special.package": "",
    "special.roc-special.provided": { "capture": "font-lock-variable-use-face", "feature": "variable-use" },
    "string": { "capture": "font-lock-string-face", "feature": "strings" },
    "string.regexp": "",
    "string.special": "",
    "string.special.path": "",
    "string.special.symbol": "",
    "string.special.url": { "capture": "font-lock-string-face", "feature": "strings" },
    "tag": "",
    "tag.builtin": "",
    "type": { "capture": "font-lock-type-face", "feature": "types" },
    "type.builtin": { "capture": "font-lock-type-face", "feature": "types" },
    "type.definition": { "capture": "font-lock-type-face", "feature": "types" },
    "type.enum": "",
    "type.enum.variant": { "capture": "font-lock-type-face", "feature": "tag-types" },
    "type.enum.variant.roc-special.builtin": { "capture": "font-lock-builtin-face", "feature": "tag-types" },
    "type.parameter": { "capture": "font-lock-type-face", "feature": "type-variables" },
    "type.roc-special.inferred": { "capture": "font-lock-type-face", "feature": "types" },
    "variable": { "capture": "font-lock-variable-use-face", "feature": "variable-use" },
    "variable.roc-special.definition": { "capture": "font-lock-variable-name-face", "feature": "definition-names" },
    "variable.roc-special.inferred-definition": { "capture": "font-lock-variable-name-face", "feature": "definition-names" },
    "variable.builtin": { "capture": "font-lock-variable-use-face", "feature": "variable-use" },
    "variable.other": "",
    "variable.other.member": { "capture": "font-lock-property-use-face", "feature": "record-field-access" },
    "variable.other.member.roc-special.declaration": { "capture": "font-lock-property-name-face", "feature": "record-field-declaration" },
    "variable.other.member.private": "",
    "variable.other.member.roc-special.in-typedef": { "capture": "font-lock-property-name-face", "feature": "record-field-declaration" },
    "variable.parameter": { "capture": "font-lock-variable-use-face", "feature": "variable-use" }
  }
}
